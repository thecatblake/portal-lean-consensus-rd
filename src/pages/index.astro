---
import Layout from "../layouts/Layout.astro";
import { articles, pages } from "../lib/content";
const latest = articles().slice(0, 5);
const others = pages();
---
<Layout title="Lean Consensus R&D">
  <h1>Lean Consensus R&amp;D</h1>
  {others.length > 0 && <ul>{others.map((p) => <li><a href={p.path}>{p.title}</a></li>)}</ul>}
  {latest.length > 0 && (
    <>
      <h2>Blog</h2>
      <ul class="list">{latest.map((a) => <li><a href={a.path}>{a.title}</a> <span class="meta">{a.datePublished}</span></li>)}</ul>
    </>
  )}
</Layout>

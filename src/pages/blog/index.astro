---
import Layout from "../../layouts/Layout.astro";
import { articles } from "../../lib/content";
const list = articles();
---

<Layout title="Blog">
  <div class="container">
    <h1>Blog</h1>
    {list.length === 0 && <p class="lede">No articles yet.</p>}
    <ul class="post-list">
      {list.map((a) => (
        <li>
          <a href={a.path}>{a.title}</a>
          <div class="meta">{a.datePublished}</div>
          {a.description && <p>{a.description}</p>}
        </li>
      ))}
    </ul>
  </div>
</Layout>

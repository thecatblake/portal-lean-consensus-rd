---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  jsonLd?: object;
}

const siteName = "Lean Consensus R&D";
const { title, description = "Research and development notes on Lean Consensus, the next-generation Ethereum consensus layer.", jsonLd } = Astro.props;
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
    <!-- Google tag (GA4) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-X9KKSN4QMC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-X9KKSN4QMC');
    </script>
    <!-- Portal analytics (cookieless: page views and booking/phone/map clicks only) -->
    <script is:inline defer src="https://portal.kryor.studio/t/s.js" data-site="1406267e-eff3-4190-b9c7-1d2c119b414d"></script>
  </head>
  <body>
    <Header current={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

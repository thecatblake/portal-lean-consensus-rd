---
import { pages } from "../lib/content";
interface Props {
  current: string;
}
const { current } = Astro.props;
// The pages published in Portal, plus the blog once there is an article.
const links = [...pages().map((p) => ({ href: p.path, label: p.title })), { href: "/blog/", label: "Blog" }];
// The top page has no heading of its own: the site title is its h1.
const Title = current === "/" ? "h1" : "p";
const isActive = (href: string) => current.startsWith(href);
---

<header class="site-header">
  <div class="container bar">
    <div class="brand-block">
      <Title class="brand-title"><a class="brand" href="/">Lean Consensus <span>R&amp;D</span></a></Title>
      <p class="tagline">Tracking the progress of Lean Consensus R&amp;D for working researchers.</p>
    </div>
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a>
          </li>
        ))}
        <li class="theme-item"><button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch theme">
          <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Light and dark. With nothing saved the page follows the system; a click saves the other one.
  const button = document.getElementById("theme-toggle") as HTMLButtonElement;
  const root = document.documentElement;
  const current = () => root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  // The icon shows the theme a click switches to (moon in light, sun in dark); CSS picks it, this keeps the label in step.
  const show = () => {
    const now = current();
    button.setAttribute("aria-label", `Switch to ${now === "dark" ? "light" : "dark"} theme`);
  };
  button.addEventListener("click", () => {
    const next = current() === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    show();
  });
  show();
</script>
